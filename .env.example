# Copy to .env.local. Never commit real values. None of these are NEXT_PUBLIC_ except the
# Turnstile *site* key, which is designed to be public.

# Canonical site URL (used for metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://jobgetabu.dev

# Contact form delivery (Resend). CONTACT_TO is the private alias inbox; it never reaches the client.
RESEND_API_KEY=
CONTACT_FROM="Portfolio <contact@jobgetabu.dev>"
CONTACT_TO=

# Cloudflare Turnstile (invisible). If unset, the form falls back to honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis REST for rate limiting across instances. If unset, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: GitHub token (read-only, public repos) to avoid API rate limits when fetching stars.
GITHUB_TOKEN=

# Optional booking link
NEXT_PUBLIC_CAL_URL=
